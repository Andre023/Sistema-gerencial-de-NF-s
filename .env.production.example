# ─────────────────────────────────────────────────────────────────────────────
# Modelo de configuração de PRODUÇÃO (VM Oracle).
# Copie para `.env` NO SERVIDOR e preencha o que está como <TROCAR>.
# NUNCA versione o .env real — ele contém segredos.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Gestão de NFs"
APP_ENV=production
APP_KEY=                         # gere no servidor: php artisan key:generate
APP_DEBUG=false                  # NUNCA true em produção (vaza stack trace/segredos)
APP_URL=https://<SEU_DOMINIO>    # ex: https://nfs.comercialmonlevade.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily                  # rotaciona os logs (em vez de um arquivo único infinito)
LOG_LEVEL=warning                # produção não precisa de debug

# ── Banco ────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_notas
DB_USERNAME=nfs_app              # usuário dedicado, NÃO use root
DB_PASSWORD=<TROCAR_SENHA_FORTE>

# ── Sessão (cookies só via HTTPS) ────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ── Tempo real (Reverb atrás do nginx, via wss na 443) ───────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=<TROCAR>           # gere: php artisan reverb:install (ou valores próprios)
REVERB_APP_KEY=<TROCAR>
REVERB_APP_SECRET=<TROCAR>
REVERB_HOST=<SEU_DOMINIO>        # o MESMO domínio do site, sem http/porta
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0       # onde o processo reverb escuta localmente
REVERB_SERVER_PORT=8080

# Estes VITE_ vão COMPILADOS no bundle (npm run build) — precisam do domínio real,
# senão o tempo real quebra em qualquer máquina que não seja o servidor.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# ── Backup fora da VM (scripts/backup.sh) ────────────────────────────────────
# PAR do Object Storage da Oracle, criado como SOMENTE ESCRITA. Vazio = o backup
# existe só nesta VM (e some junto com ela). Como criar: DEPLOY.md, seção 9.
BACKUP_PAR_URL=

# ── Monitoramento (scripts/monitorar.sh) ─────────────────────────────────────
# URL de heartbeat (healthchecks.io ou similar). O monitor só a chama quando está
# TUDO de pé — é a ausência do sinal que dispara o alerta, e é assim que você
# fica sabendo se a VM inteira caiu. Ver DEPLOY.md, seção 10.1.
MONITOR_HEARTBEAT_URL=

# ── E-mail (necessário para "esqueci minha senha") ───────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=<SEU_SMTP>             # ex: smtp do Google Workspace/provedor
MAIL_PORT=587
MAIL_USERNAME=<TROCAR>
MAIL_PASSWORD=<TROCAR>
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="nfs@<SEU_DOMINIO>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
